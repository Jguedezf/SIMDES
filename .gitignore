# claude code (personal overrides, not shared config)
.claude/settings.local.json

# documentación de trabajo interno (13/09) — bitácora, informe, manual de
# defensa, capturas y diagramas son notas/entregables de uso personal de
# Johanna, no contenido para el repositorio público. El informe oficial se
# entrega aparte, como documento Word/APA. El repo público queda para el
# código y el README.
/docs/

# exports de trabajo de workflows de n8n (13/09) — copias de diagnóstico
# bajadas manualmente durante una sesión puntual, no código del proyecto.
/n8n-workflow-original.json
/n8n-workflow-corregido.json
